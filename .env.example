# Telegram-бот
BOT_TOKEN=123456:ABC-DEF...
BOT_USERNAME_URL=https://t.me/harmony_vpn_bot

# Marzban (панель, которая реально управляет Xray-нодами)
MARZBAN_URL=https://panel.example.com
MARZBAN_ADMIN_USERNAME=admin
MARZBAN_ADMIN_PASSWORD=change_me

# База данных Harmony (заказы, тарифы, рефералка)
# Для разработки: sqlite+aiosqlite:///./harmony.db
# Для docker-compose/прода: postgresql+asyncpg://harmony:harmony@db:5432/harmony
DATABASE_URL=sqlite+aiosqlite:///./harmony.db

# ЮKassa (необязательно — если не задано, способ не появится в боте)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# CryptoBot (необязательно — если не задано, способ не появится в боте)
CRYPTOBOT_API_TOKEN=

# Telegram Stars: курс "рублей за 1 звезду" для расчёта цены
RUB_PER_STAR=2.0

# Telegram chat_id админа/группы поддержки — сюда падают уведомления о новых
# тикетах поддержки и сообщениях в них
ADMIN_CHAT_ID=

# Telegram user_id администраторов через запятую — кому доступны админ-команды
# (/referral_mode, /broadcast_add, /reply, /close_ticket и т.п.). Узнать свой
# telegram_id можно через @userinfobot
ADMIN_IDS=

# Какие proxy-протоколы и inbound'ы выдавать новым пользователям в Marzban.
# Должны быть валидным JSON и совпадать с тем, что настроено в самой Marzban-панели.
DEFAULT_PROXIES={"vless": {}}
DEFAULT_INBOUNDS={"vless": ["VLESS TCP REALITY"]}

# Только для docker-compose: креды для сервиса db (Postgres)
POSTGRES_USER=harmony
POSTGRES_PASSWORD=harmony
POSTGRES_DB=harmony
